PORT=3000
NODE_ENV=development

# Neon / PostgreSQL
DB_HOST=tu-host-de-neon.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_PASSWORD=tu_password_aqui
DB_NAME=neondb
DB_SSL_REJECT_UNAUTHORIZED=1

# JWT
JWT_SECRET=tu_clave_secreta_minimo_32_caracteres
JWT_EXPIRES_IN=24h

# ── Email via Brevo API (no usa SMTP — compatible con Render y cualquier host) ──
# 1. Crea cuenta gratis en https://brevo.com
# 2. Ve a Settings → API Keys → Generate a new API key
# 3. Verifica tu email remitente en Settings → Senders & IPs (sin necesitar dominio propio)
BREVO_API_KEY=tu_api_key_de_brevo_aqui
MAIL_FROM=tu_email_verificado@gmail.com

# CORS — en producción pon tu dominio de Vercel
CORS_ORIGIN=*
