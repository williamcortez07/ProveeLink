PORT=3000
NODE_ENV=development

# Neon / PostgreSQL
DB_HOST=tu-host-de-neon.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_PASSWORD=tu_password_aqui
DB_NAME=neondb
DB_SSL_REJECT_UNAUTHORIZED=1

# JWT
JWT_SECRET=tu_clave_secreta_minimo_32_caracteres
JWT_EXPIRES_IN=24h

# ── Email via Resend API (no usa SMTP — compatible con Render y cualquier host) ──
# 1. Crea cuenta gratis en https://resend.com
# 2. Ve a API Keys y genera una
# 3. Para pruebas sin dominio propio usa MAIL_FROM=onboarding@resend.dev
# 4. Para producción verifica tu dominio en Resend y usa: ProveeLink <info@tudominio.com>
RESEND_API_KEY=re_tu_api_key_aqui
MAIL_FROM=onboarding@resend.dev

# CORS — en producción pon tu dominio de Vercel
CORS_ORIGIN=*
